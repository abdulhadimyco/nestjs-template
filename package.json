{
  "name": "nestjs-template",
  "version": "0.1.0",
  "description": "NestJS (Fastify) + strict TypeScript + Mongoose + Redis service template. Generate a new backend service from this repository.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "rimraf dist && nest build --path tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "dev:prod": "node --env-file=.env.production node_modules/@nestjs/cli/bin/nest.js start --watch",
    "debug": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --debug=0.0.0.0:9229 --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts",
    "check:deps": "knip",
    "gate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run test:e2e && pnpm run openapi:check && pnpm run build",
    "prepare": "node .husky/install.mjs",
    "openapi:generate": "node --env-file=.env.test -r ts-node/register -r tsconfig-paths/register scripts/generate-openapi.ts",
    "openapi:check": "node --env-file=.env.test -r ts-node/register -r tsconfig-paths/register scripts/generate-openapi.ts --check",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "fastify": "^5.11.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@swc/cli": "^0.7.0",
    "@swc/core": "^1.15.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.9.0",
    "jest": "^30.5.2",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  }
}
