NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MONGO_URI=mongodb://localhost:27017/app
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_JWT_SECRET=change-me
JWT_EXPECTED_ISSUER=
JWT_EXPECTED_AUDIENCE=
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# "true" trusts every hop, "false" trusts none, an integer is a hop count (e.g. "1" behind Cloudflare
# alone), or a comma list of trusted proxy IPs/CIDRs.
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
